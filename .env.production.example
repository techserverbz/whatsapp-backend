# ============================================================================
#  wpp-backend — PRODUCTION env  (copy to `.env` on the Windows server)
#  Host: wa-api.bhole.co   FE: https://wa.bhole.co   CRM: https://scrm.bhole.co
#  NEVER commit the real .env. Fill every <PLACEHOLDER> below.
# ============================================================================

NODE_ENV=production

# Bind to loopback only — the Cloudflare Tunnel / reverse proxy is the ONLY
# thing that talks to this port. Do NOT use 0.0.0.0 in production.
HOST=127.0.0.1
PORT=8099

# --- CRM Single Sign-On (shared secret with scrm.bhole.co) -------------------
# MUST be scrm.bhole.co's LIVE production JWT_SECRET (identical value, byte for
# byte). If this differs from the CRM's prod secret, every login is rejected.
JWT_SECRET=<PASTE_SCRM_PROD_JWT_SECRET>

# CRM production database — used ONLY to re-check token_version / is_disabled
# for instant revocation. Same connection string the CRM backend uses in prod.
DATABASE_URL=<PASTE_SCRM_PROD_DATABASE_URL>
DB_SCHEMA=prod
AUTH_CACHE_MS=15000

# --- Cross-origin / cookie scope --------------------------------------------
# Only the deployed frontend may call this API with credentials.
CORS_ORIGIN=https://wa.bhole.co
# So sign-out can clear the shared crm_token cookie across *.bhole.co.
COOKIE_DOMAIN=.bhole.co

# --- Device admins (only these may scan the QR / logout the device) ----------
WPP_ADMIN_EMAILS=shubhambhole68@gmail.com,akashkambli123@gmail.com
# Viewers are read-only by default. Set true ONLY if viewers should also send.
WPP_ALLOW_VIEWER_SEND=false

# --- WhatsApp session --------------------------------------------------------
WPP_SESSION=wpp-standalone
WPP_HEADLESS=true
WPP_AUTO_START=true
MAX_UPLOAD_MB=32

# API_KEY is NOT needed when CRM SSO (JWT_SECRET) is set — SSO is the auth layer.
# API_KEY=
