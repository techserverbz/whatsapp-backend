NODE_ENV=production

# Bind to all interfaces so the backend is reachable on the LAN and externally
HOST=0.0.0.0
PORT=5000

# --- CRM Single Sign-On (shared secret with scrm.bhole.co) ---
JWT_SECRET=a7f3c9e2b1d84f6e8a0c5b2e9d71a4f8c3b6e1d90a7f2c5b8e4d1a9f6c3e7b0d2

# CRM production database — used for instant token_version revocation checks
DATABASE_URL="postgresql://postgres.rrkizezxewgzouiywixm:mlpnkobjivhu@aws-1-ap-south-1.pooler.supabase.com:6543/postgres"
DB_SCHEMA=prod
AUTH_CACHE_MS=15000

# --- Cross-origin / cookie scope ---
# Local dev origins first (FE on :3010), then production. The backend honours
# this list exactly, so the dev frontend must be listed or the browser blocks it.
CORS_ORIGIN=http://localhost:3010,http://127.0.0.1:3010,https://wapp.bhole.co
COOKIE_DOMAIN=.bhole.co

# --- Device admins (only these may scan the QR / logout the device) ---
WPP_ADMIN_EMAILS=shubhambhole68@gmail.com,akashkambli123@gmail.com
WPP_ALLOW_VIEWER_SEND=false

# --- WhatsApp session ---
WPP_SESSION=wpp-standalone
WPP_HEADLESS=true
# Dev on :5000 does NOT auto-open the WhatsApp session — the live NSSM service on
# :8099 owns it (single-Chromium lock). Set true only if the :8099 service is stopped.
WPP_AUTO_START=false
MAX_UPLOAD_MB=32
