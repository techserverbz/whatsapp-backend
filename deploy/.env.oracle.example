# ---------------------------------------------------------------------------
# Native (no-Docker) runtime env for the Oracle Cloud Linux VM.
# The setup script copies this to  ../.env  (repo root) and fills
# PUPPETEER_EXECUTABLE_PATH with the Chromium it detected. The app loads this
# file itself via dotenv (src/config.ts), so systemd just sets WorkingDirectory.
#
# You only MUST fill the two secrets: JWT_SECRET and DATABASE_URL.
# NEVER commit the filled ../.env (it is gitignored).
# ---------------------------------------------------------------------------

NODE_ENV=production

# Bind loopback only: cloudflared runs on this same host and dials out, so the
# app never needs to be reachable from the public internet directly.
HOST=127.0.0.1
PORT=8099

# --- Chromium (auto-filled by deploy/oracle-native-setup.sh) ---
# Both engines (wppconnect + whatsapp-web.js) honour this. Leave the placeholder;
# the script rewrites it to the real binary path (e.g. /usr/bin/chromium-browser).
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_DOWNLOAD=true

# --- Behind Cloudflare Tunnel ---
# cloudflared is a non-loopback hop; trust it so the cookie Secure flag and
# per-client rate limiting work. Safe: the origin is only reachable via the tunnel.
TRUST_PROXY=1

# --- Cross-origin / cookie scope (must match the Vercel FE) ---
CORS_ORIGIN=https://wapp.bhole.co
COOKIE_DOMAIN=.bhole.co

# --- CRM Single Sign-On (SECRETS — FILL THESE TWO) ---
JWT_SECRET=__PASTE_CRM_JWT_SECRET__
DATABASE_URL=__PASTE_CRM_POSTGRES_URL__
DB_SCHEMA=prod
AUTH_CACHE_MS=15000
CRM_API_URL=https://sam-crm-be.vercel.app/v1

# --- Device admins (only these may scan the QR / log out the device) ---
WPP_ADMIN_EMAILS=shubhambhole68@gmail.com,akashkambli123@gmail.com
WPP_ALLOW_VIEWER_SEND=false

# --- WhatsApp session + persistent state ---
# Paths mirror the Windows PC layout 1:1 so a full data migration
# (deploy/pack-state.sh -> deploy/restore-state.sh) is a straight extract.
# All are NON-hidden so a snap-confined Chromium (Ubuntu) can write to them.
WPP_SESSION=wpp-standalone
WPP_HEADLESS=true
WPP_AUTO_START=true
MAX_UPLOAD_MB=32
WPP_TOKEN_FOLDER=./tokens
WPP_DATA_FOLDER=./data
WA_SESSION_PATH=./wa-sessions

# WA_WEB_VERSION intentionally unset -> falls back to the pinned build
# vendored in .wwebjs_cache.
