# ---- WPPConnect Backend configuration ----

# HTTP / Socket.io server
PORT=8099

# Network interface to bind. 0.0.0.0 = reachable from other devices on your LAN
# (so the same session shows up on your other PCs). Set to 127.0.0.1 to restrict
# to this machine only.
HOST=0.0.0.0

# Allowed CORS origin(s). Leave EMPTY to auto-allow localhost + private LAN
# addresses (recommended — works from other devices, blocks public websites).
# Or set an exact allow-list ("http://192.168.1.50:3010") or "*".
CORS_ORIGIN=

# ── CRM SSO ──
# Shared secret with the SAM CRM (MUST equal the CRM's JWT_SECRET). When set,
# every REST route + socket requires a valid CRM login (the `crm_token` cookie),
# so only logged-in CRM users can access the app. This is the primary auth.
JWT_SECRET=

# CRM database (SAME as the CRM's DATABASE_URL + DB_SCHEMA). Lets this app
# re-check the user's live tokenVersion / disabled state for INSTANT revocation
# — a CRM logout / password reset / disable cuts off access within AUTH_CACHE_MS.
# Leave DATABASE_URL empty to skip revocation (token is then valid until expiry).
DATABASE_URL=
DB_SCHEMA=prod
AUTH_CACHE_MS=15000

# (Legacy) simple shared secret. Only used when JWT_SECRET above is empty.
API_KEY=

# Max upload size in MB for base64 media (documents/videos).
MAX_UPLOAD_MB=32

# WhatsApp session
WPP_SESSION=wpp-standalone
WPP_TOKEN_FOLDER=./tokens

# Run the puppeteer browser headless (true) or visible (false, useful for debugging)
WPP_HEADLESS=true

# Auto-resume a previously linked session on server boot (no QR re-scan). This
# keeps the same session alive across restarts and instantly available to any
# browser/machine that connects to this backend. Set to false to require a
# manual "Connect" click.
WPP_AUTO_START=true
