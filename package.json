{
  "name": "wpp-backend",
  "version": "1.0.0",
  "description": "Standalone WhatsApp Web backend powered by WPPConnect (REST API + Socket.io)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:tunnel": "node scripts/tunnel-up.mjs && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:tunnel": "node scripts/tunnel-up.mjs && node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "whatsapp",
    "wppconnect",
    "express",
    "socket.io"
  ],
  "license": "MIT",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.6",
    "@wppconnect-team/wppconnect": "^1.37.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
